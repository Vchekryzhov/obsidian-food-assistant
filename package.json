{
  "name": "obsidian-food-assistant",
  "version": "0.2.1",
  "private": true,
  "description": "A distributable local-first food assistant module for Obsidian and Codex.",
  "author": "Vchekryzhov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vchekryzhov/obsidian-food-assistant.git"
  },
  "bugs": "https://github.com/Vchekryzhov/obsidian-food-assistant/issues",
  "homepage": "https://github.com/Vchekryzhov/obsidian-food-assistant#readme",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint src",
    "test": "node --experimental-strip-types --import ./test/register-md-loader.mjs --test test/*.test.ts",
    "test:ui": "node scripts/test-ui.mjs",
    "check": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.11.4",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1"
  }
}
