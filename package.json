{
  "name": "obsidian-food-assistant",
  "version": "0.2.0",
  "private": true,
  "description": "A distributable local-first food assistant module for Obsidian and Codex.",
  "author": "Vchekryzhov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vchekryzhov/obsidian-food-assistant.git"
  },
  "bugs": "https://github.com/Vchekryzhov/obsidian-food-assistant/issues",
  "homepage": "https://github.com/Vchekryzhov/obsidian-food-assistant#readme",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.11.4",
    "typescript": "^5.9.0"
  }
}
